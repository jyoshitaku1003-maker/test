{
  "expo": {
    "name": "Japan Flight",
    "slug": "japan-flight-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#001529"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.japanflight",
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#001529"
      },
      "package": "com.yourname.japanflight",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {}
  }
}
